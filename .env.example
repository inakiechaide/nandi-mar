# Variables a cargar en Vercel (Project Settings → Environment Variables)
ADMIN_USER=admin
ADMIN_PASSWORD=una-contraseña-larga
# Cadena aleatoria larga, ej: openssl rand -hex 32
SESSION_SECRET=
# Token fine-grained de GitHub con acceso solo a este repo y permiso Contents: Read and write
GITHUB_TOKEN=
# Opcionales
GITHUB_REPO=inakiechaide/nandi-mar
GITHUB_BRANCH=main
